# 复制成 .env 后填真实值。所有密钥类的值本地开发用假值即可，生产部署走
# SSM Parameter Store（SecureString）传进容器环境变量，不要把真实值提交进仓库。
# 见 docs/design.md 4.1 / 4.4 节。

# 只有 development 允许下面这几个占位密钥原样跑起来；生产环境（默认值就是
# production）如果密钥还是占位符，应用会在启动时直接拒绝启动，不会带着假密钥
# 上线，见 app/core/config.py。
ENVIRONMENT=development

# --- Keycloak 基础信息 ---
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=quick

# --- 4.1 节：后端调 Admin REST API 用的 service account client（manage-users 权限）---
# 生产环境这两个 secret 至少要 32 位真随机值，太短/太简单会被 app/core/config.py
# 的校验直接拒绝启动（development 环境不受限，占位值能跑）。
KEYCLOAK_SERVICE_CLIENT_ID=quick-account-manager-service
KEYCLOAK_SERVICE_CLIENT_SECRET=changeme

# --- 4.4 节：应用自身登录用的 OIDC client（Authorization Code 流程）---
KEYCLOAK_OIDC_CLIENT_ID=quick-account-manager-web
KEYCLOAK_OIDC_CLIENT_SECRET=changeme
# 本地开发用 http://localhost:8000/auth/callback；生产环境改成
# https://quick-admin.example.com/auth/callback
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# 允许登录本应用的 Keycloak 组（4.4 节：复用 /quick-admin-pro，不单独建权限表）
ADMIN_GROUP_PATH=/quick-admin-pro

# --- 应用会话 ---
# 至少 32 位随机值，本地开发可以随便填，生产环境务必换成真随机值
# （比如 `openssl rand -hex 32`），太短会被启动校验直接拒绝
SESSION_SECRET_KEY=change-this-to-a-random-secret-in-production

# --- 数据库（5 节：只有 audit_log 一张表，SQLite 就够）---
DATABASE_URL=sqlite:///./data/app.db

# --- QuickSight 订阅状态核对（4.3 节，只读，可选——本地没配也能跑，只是列表页订阅状态显示"未知"）---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
